{
  "name": "bridge-proof",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "wallet:devnet": "tsx scripts/create-devnet-wallet.ts",
    "bootstrap:devnet": "tsx --env-file-if-exists=.env.local scripts/bootstrap-devnet.ts",
    "verify:devnet": "tsx --env-file-if-exists=.env.local scripts/verify-credential.ts",
    "smoke:devnet": "tsx --env-file-if-exists=.env.local scripts/smoke-devnet.ts"
  },
  "engines": { "node": ">=22.0.0" },
  "dependencies": {
    "@solana/kit": "^5.0.0",
    "next": "16.4.0",
    "openai": "^7.32.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sas-lib": "1.0.10",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
