# Server-only configuration. Copy to .env.local and fill in locally.
# Never add NEXT_PUBLIC_ to secrets or commit .env.local / wallet files.

# Public deployment defaults to read-only even if this variable is absent.
# Keep true on Vercel: both POST routes are blocked before any signing/AI work.
# Set false ONLY for an explicitly enabled local issuance workflow.
BRIDGE_PROOF_READ_ONLY=true

# The public read-only deployment needs NONE of the secret settings below.
# Optional local real AI integration. Leave blank on the public deployment.
# Paid provider requests require explicitly disabling AI_DEMO_MODE below.
OPENAI_API_KEY=
OPENAI_MODEL=

# Safe demo configuration for development AND production: no OpenAI calls.
# true overrides even an existing key. Without a key, demo is always the fallback.
AI_DEMO_MODE=true

# Local issuance only: random secret of at least 32 characters. Never deploy it.
CREDENTIAL_SIGNING_SECRET=

# Optional HTTPS Devnet RPC. Defaults to https://api.devnet.solana.com.
SOLANA_RPC_URL=

# Local issuance only. Keep both absent from the public Vercel deployment.
# Choose ONE: the entire 64-byte keypair JSON array OR a local keypair file path.
# npm run wallet:devnet creates .local/devnet-issuer.json; fund it before bootstrap.
SOLANA_ISSUER_SECRET_KEY=
SOLANA_ISSUER_KEYPAIR_PATH=

# Public trust configuration printed by npm run bootstrap:devnet.
SOLANA_ISSUER_PUBLIC_KEY=
SAS_CREDENTIAL_ADDRESS=
SAS_SCHEMA_ADDRESS=

# Optional live smoke-test target. Defaults to http://127.0.0.1:3000.
APP_BASE_URL=
